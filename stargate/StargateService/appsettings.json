{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Transceiver": {
    "Host": "127.0.0.1",
    "Port": 6000
  },
  "PythonAutomation": {
    "Enabled": true,
    "PythonExecutable": "python",
    "BaseWorkingDirectory": "../..",
    "Processes": [
      {
        "Name": "BLonQ Transceiver Mock",
        "InterpreterArguments": "",
        "Script": "transceiver/blonq_transceiver_mock.py",
        "Environment": {
          "BLONQ_TARGET_HOST": "127.0.0.1",
          "BLONQ_TARGET_PORT": "6000"
        }
      },
      {
        "Name": "Telemetry Web Dashboard",
        "InterpreterArguments": "",
        "Script": "client/web_dashboard.py",
        "Environment": {
          "STARGATE_HOST": "127.0.0.1",
          "STARGATE_PORT": "5000",
          "DASHBOARD_HOST": "127.0.0.1",
          "DASHBOARD_PORT": "8000"
        }
      }
    ]
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
